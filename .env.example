# Uygulamanın bağlandığı veritabanı.
# ÖNEMLİ: bu bağlantı tabloların SAHİBİ olmayan bir rol kullanmalıdır.
DATABASE_URL=postgresql://sezra_owner:sezra_owner@localhost:5432/sezra_dev

# Bağlantı owner rolüyle açılıyorsa, her istekte bu role düşülür (yetki daraltma).
# Supabase'de bağlantı zaten `authenticated` ile açıldığından boş bırakılabilir.
DB_APP_ROLE=sezra_app

# auth | dev  — dev modu yalnızca yerel geliştirme içindir, NODE_ENV=production ile açılmaz
AUTH_MODE=dev
SUPABASE_JWT_SECRET=

PORT=3000
NODE_ENV=development

# Bagli mail hesaplarinin (IMAP/POP3/Graph/Gmail) parola ve token'larini
# sifrelemek icin kullanilir. 32 bayt: 64 hex karakter ya da base64.
# Uret:  openssl rand -hex 32
# Tanimli degilse kullanicilar mail hesabi baglayamaz (panel oyle yazar).
MAIL_SECRET_KEY=

# Microsoft Graph / Gmail OAuth uygulama kimlikleri. Insanin Azure ve Google
# Cloud'da uygulama kaydetmesi gerekir; tanimli degilse o saglayici panelde
# "yapilandirilmamis" gorunur.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT=common
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# OAuth callback'lerinin dondugu taban adres (kayitli redirect URI ile eslesmeli).
OAUTH_REDIRECT_BASE=http://localhost:3000

# --- Cari acarken VKN'den firma bilgisi getirme (T-028) --------------------
# GIB e-Fatura "PublicUserService" SOAP uc noktasi. Ucretsiz, kimlik gerektirmez.
# Bos birakilirsa varsayilan GIB merkez adresi kullanilir; ilk gercek kurulumda
# adresi ve yanit bicimini dogrulayin (core/src/company/gib.ts icindeki not).
GIB_EFATURA_WS_URL=

# Opsiyonel ucretli firma-bilgisi saglayici. IKISI de tanimliysa devreye girer,
# yoksa panelde "yapilandirilmamis" gorunur. Anahtar istemciye ASLA gitmez.
COMPANY_LOOKUP_PAID_URL=
COMPANY_LOOKUP_PAID_KEY=
# Belirli bir saglayiciyi sabitlemek icin (ornek: 'gib' | 'paid'). Bos = otomatik
# (ucretli yapilandirilmissa once o, sonra GIB). Testler 'fake' ile kullanir.
COMPANY_LOOKUP_PROVIDER=
